DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
PORT=4000

# Used only by `npm run seed` to create/update the single admin account
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Used by POST /api/uploads (@vercel/blob). Created automatically when you
# connect a Blob store to this project in the Vercel dashboard (Storage tab);
# for local dev, run `vercel env pull` after connecting it, or copy the token
# from Storage > your Blob store > .env.local tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
